# DBA-Rohkorpus: amtliche BMF-PDFs nur lokal (225M, reproduzierbar via corpus/scrape_dba.py)
corpus/dba_pdfs/
# Urheberrechtlich geschuetzt (NWB-Redaktionstexte, Kommentar-Literatur) — NIE committen/pushen
corpus/dba_text_nwb/
corpus/kommentare/
# Werkzeug-Output (Codebase-Graph, 11M AST-Cache) — reproduzierbar, nie committen
graphify-out/
# Werkzeug-Laufzeitzustand (nord-Shelljobs) und Audit-Berichte externer Läufe.
