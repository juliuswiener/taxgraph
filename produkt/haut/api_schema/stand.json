{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "haut.stand response",
  "type": "object",
  "required": ["fall_id", "snapshot_id", "engine", "felder", "relevanz", "intervall",
               "teil_ringe", "ring_gesperrt"],
  "additionalProperties": false,
  "properties": {
    "fall_id": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "engine": {"type": "string", "enum": ["catala", "catala_teilweise", "unavailable", "gesperrt"]},
    "ring_gesperrt": {"type": ["string", "null"]},
    "felder": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["wert", "zustand", "herkunft", "herkunft_badge"],
        "additionalProperties": false,
        "properties": {
          "wert": {},
          "zustand": {"type": "string", "enum": ["vorlaeufig", "bestaetigt"]},
          "herkunft": {"type": "object"},
          "herkunft_badge": {"type": "string",
            "enum": ["laie", "beleg_import", "vorjahr", "berechnet", "orakel", "llm_vorschlag"]}
        }
      }
    },
    "relevanz": {"type": "object"},
    "intervall": {"type": ["object", "null"]},
    "teil_ringe": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["familie", "quantitaet", "intervall"],
        "additionalProperties": false,
        "properties": {
          "familie": {"type": "string"},
          "quantitaet": {"type": "string"},
          "intervall": {"type": "object"}
        }
      }
    }
  }
}
