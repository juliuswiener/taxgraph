{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "haut.stand response",
  "type": "object",
  "required": ["fall_id", "snapshot_id", "engine", "felder", "relevanz", "intervall",
               "teil_ringe", "ring_gesperrt"],
  "additionalProperties": false,
  "properties": {
    "fall_id": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "engine": {"type": "string", "enum": ["catala", "catala_teilweise", "unavailable", "gesperrt"]},
    "ring_gesperrt": {"type": ["string", "null"]},
    "felder": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "$comment": "Die letzten fuenf ab 2026-08-24: dieselben Anzeige-Metadaten, die chat() schon lieferte (api._anzeige_metadaten). Ohne sie zeigte die Liste der beantworteten Felder die Feld-Kennung und den Cent-Rohwert — `bruttoarbeitslohn 2500000` —, also genau die zwei Dinge, die ein Laie nicht lesen kann. Alle fuenf duerfen null sein: steht das Feld nicht (mehr) in der Bindung, faellt die Oberflaeche auf Kennung + Rohwert zurueck.",
        "required": ["wert", "zustand", "herkunft", "herkunft_badge", "event_id",
                     "frage", "typ", "frage_invertiert", "einheit", "enum_labels"],
        "additionalProperties": false,
        "properties": {
          "wert": {},
          "zustand": {"type": "string", "enum": ["vorlaeufig", "bestaetigt"]},
          "herkunft": {"type": "object"},
          "herkunft_badge": {"type": "string",
            "enum": ["laie", "beleg_import", "vorjahr", "kontoauszug", "berechnet", "orakel", "llm_vorschlag"]},
          "event_id": {"type": ["string", "null"]},
          "frage": {"type": ["string", "null"]},
          "typ": {"type": ["string", "null"],
                  "enum": ["cent", "int", "bool", "enum", "datum", "text", null]},
          "frage_invertiert": {"type": "boolean"},
          "einheit": {"type": ["string", "null"]},
          "enum_labels": {"type": ["object", "null"]}
        }
      }
    },
    "relevanz": {"type": "object"},
    "intervall": {"type": ["object", "null"]},
    "teil_ringe": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["familie", "quantitaet", "intervall"],
        "additionalProperties": false,
        "properties": {
          "familie": {"type": "string"},
          "quantitaet": {"type": "string"},
          "intervall": {"type": "object"}
        }
      }
    }
  }
}
