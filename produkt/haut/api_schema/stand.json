  "properties": {
    "fall_id": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "engine": {"type": "string", "enum": ["catala", "unavailable"]},
    "felder": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["wert", "zustand", "herkunft", "herkunft_badge"],
        "additionalProperties": false,
        "properties": {
          "wert": {},
          "zustand": {"type": "string", "enum": ["vorlaeufig", "bestaetigt"]},
          "herkunft": {"type": "object"},
          "herkunft_badge": {"type": "string", "enum": ["solide", "schimmernd"]}
