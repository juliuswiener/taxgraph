      "additionalProperties": false,
      "properties": {
        "feld_id": {"type": "string"},
        "wert": {},
        "zustand": {"type": "string", "enum": ["vorlaeufig", "bestaetigt"]},
        "herkunft": {"type": "object"},
        "event_id": {"type": "string", "minLength": 64},
        "signal": {"type": ["object", "null"]},
        "regel_id": {"type": ["string", "null"]},
        "signatur_slot": {"type": ["string", "null"]},
        "geltungsbedingung": {"type": ["string", "null"]},
