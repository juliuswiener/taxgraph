{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "haut.fragen response",
  "type": "object",
  "required": ["fall_id", "snapshot_id", "fragen"],
  "additionalProperties": false,
  "properties": {
    "fall_id": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "fragen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feld_id", "typ", "fragetext_laie", "hilfe_kurz", "einheit", "bereich",
                     "enum_werte", "enum_labels", "beispielwert", "anker_ref"],
        "additionalProperties": false,
        "properties": {
          "feld_id": {"type": "string"},
          "fragetext_laie": {"type": ["string", "null"]},
          "hilfe_kurz": {"type": ["string", "null"]},
          "typ": {"type": "string", "enum": ["cent", "int", "bool", "enum", "datum", "text"]},
          "einheit": {"type": ["string", "null"]},
          "bereich": {"type": ["object", "null"]},
          "enum_werte": {"type": ["array", "null"]},
          "enum_labels": {
            "type": ["object", "null"],
            "description": "Anzeigetext je enum_wert (2026-08-14). null bei Nicht-enum-Feldern; die UI faellt dann auf den Rohwert zurueck. Ohne diese Texte las der Nutzer 'land_forst' oder bei den Kindschaftsverhaeltnissen nur '1'.",
            "additionalProperties": {"type": "string"}
          },
          "beispielwert": {},
          "anker_ref": {"type": ["object", "null"]}
        }
      }
    }
  }
}
