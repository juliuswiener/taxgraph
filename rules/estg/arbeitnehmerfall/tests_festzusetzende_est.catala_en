# Tests Arbeitnehmerfall - festzusetzende ESt

> Using Einkommensteuertarif

End-to-end-Testfaelle: Bruttoarbeitslohn rein, zvE und festzusetzende ESt raus.
Erwartungswerte gegen die GETTSIM-Tarif-Oracle am abgeleiteten zvE bestimmt
(Kette § 9a-Pauschbetrag -> § 10c-Pauschbetrag -> § 32a).

## Einzelveranlagung

```catala
#[test]
declaration scope TestEinzel2026:
  internal r1 content Einkommensteuertarif.FestzusetzendeEstEinzel
  internal r2 content Einkommensteuertarif.FestzusetzendeEstEinzel
  internal r3 content Einkommensteuertarif.FestzusetzendeEstEinzel
  internal r4 content Einkommensteuertarif.FestzusetzendeEstEinzel
  output zve1 content money
  output est1 content money
  output est2 content money
  output est3 content money
  output zve4 content money
  output est4 content money

scope TestEinzel2026:
  # brutto 60000, keine WK/SA -> zvE 58734, ESt 13747
  definition r1 equals output of Einkommensteuertarif.FestzusetzendeEstEinzel with {
    -- bruttoarbeitslohn: $60,000.00
    -- werbungskosten: $0.00
    -- sonderausgaben: $0.00
    -- veranlagungszeitraum: VZ2026 }
  definition zve1 equals r1.zu_versteuerndes_einkommen
  definition est1 equals r1.festzusetzende_est
  assertion zve1 = $58,734.00
  assertion est1 = $13,747.00

  # brutto 30000 -> zvE 28734, ESt 3862
  definition r2 equals output of Einkommensteuertarif.FestzusetzendeEstEinzel with {
    -- bruttoarbeitslohn: $30,000.00
    -- werbungskosten: $0.00
    -- sonderausgaben: $0.00
    -- veranlagungszeitraum: VZ2026 }
  definition est2 equals r2.festzusetzende_est
  assertion est2 = $3,862.00

  # brutto 15000 -> zvE 13734, ESt 211
  definition r3 equals output of Einkommensteuertarif.FestzusetzendeEstEinzel with {
    -- bruttoarbeitslohn: $15,000.00
    -- werbungskosten: $0.00
    -- sonderausgaben: $0.00
    -- veranlagungszeitraum: VZ2026 }
  definition est3 equals r3.festzusetzende_est
  assertion est3 = $211.00

  # brutto 60000, WK 2000 (> Pauschbetrag), SA 500 (> Pauschbetrag)
  # -> zvE 60000 - 2000 - 500 = 57500, ESt 13279
  definition r4 equals output of Einkommensteuertarif.FestzusetzendeEstEinzel with {
    -- bruttoarbeitslohn: $60,000.00
    -- werbungskosten: $2,000.00
    -- sonderausgaben: $500.00
    -- veranlagungszeitraum: VZ2026 }
  definition zve4 equals r4.zu_versteuerndes_einkommen
  definition est4 equals r4.festzusetzende_est
  assertion zve4 = $57,500.00
  assertion est4 = $13,279.00

#[test]
declaration scope TestEinzelWeitereVz:
  internal r25 content Einkommensteuertarif.FestzusetzendeEstEinzel
  internal r24 content Einkommensteuertarif.FestzusetzendeEstEinzel
  output est25 content money
  output est24 content money

scope TestEinzelWeitereVz:
  # VZ 2025, brutto 80000 -> zvE 78734, ESt 22156
  definition r25 equals output of Einkommensteuertarif.FestzusetzendeEstEinzel with {
    -- bruttoarbeitslohn: $80,000.00
    -- werbungskosten: $0.00
    -- sonderausgaben: $0.00
    -- veranlagungszeitraum: VZ2025 }
  definition est25 equals r25.festzusetzende_est
  assertion est25 = $22,156.00

  # VZ 2024, brutto 50000 -> zvE 48734, ESt 10420
  definition r24 equals output of Einkommensteuertarif.FestzusetzendeEstEinzel with {
    -- bruttoarbeitslohn: $50,000.00
    -- werbungskosten: $0.00
    -- sonderausgaben: $0.00
    -- veranlagungszeitraum: VZ2024 }
  definition est24 equals r24.festzusetzende_est
  assertion est24 = $10,420.00
```

## Zusammenveranlagung

```catala
#[test]
declaration scope TestZusammen2026:
  internal r1 content Einkommensteuertarif.FestzusetzendeEstZusammen
  internal r2 content Einkommensteuertarif.FestzusetzendeEstZusammen
  output zve1 content money
  output est1 content money
  output est2 content money

scope TestZusammen2026:
  # A 60000, B 40000, keine WK/SA -> Einkuenfte 58770 + 38770 = 97540,
  # minus 72 (2x Pauschbetrag) = 97468, Splitting -> 20212
  definition r1 equals output of Einkommensteuertarif.FestzusetzendeEstZusammen with {
    -- bruttoarbeitslohn_a: $60,000.00
    -- werbungskosten_a: $0.00
    -- bruttoarbeitslohn_b: $40,000.00
    -- werbungskosten_b: $0.00
    -- sonderausgaben_gemeinsam: $0.00
    -- veranlagungszeitraum: VZ2026 }
  definition zve1 equals r1.zu_versteuerndes_einkommen_gemeinsam
  definition est1 equals r1.festzusetzende_est
  assertion zve1 = $97,468.00
  assertion est1 = $20,212.00

  # A 80000, B 0 (Alleinverdiener) -> Einkuenfte 78770 + 0, minus 72 = 78698,
  # Splitting -> 14008
  definition r2 equals output of Einkommensteuertarif.FestzusetzendeEstZusammen with {
    -- bruttoarbeitslohn_a: $80,000.00
    -- werbungskosten_a: $0.00
    -- bruttoarbeitslohn_b: $0.00
    -- werbungskosten_b: $0.00
    -- sonderausgaben_gemeinsam: $0.00
    -- veranlagungszeitraum: VZ2026 }
  definition est2 equals r2.festzusetzende_est
  assertion est2 = $14,008.00
```

## § 2-Stufenfolge und § 9a Satz 2 (negative Einkuenfte)

```catala
#[test]
declaration scope TestStufen2026:
  internal r content Einkommensteuertarif.FestzusetzendeEstEinzel
  output sde content money
  output gde content money
  output eink content money
  output zve content money
  output tarif content money
  output fest content money

scope TestStufen2026:
  # brutto 60000: einkuenfte 58770 -> SdE=GdE 58770 -> Einkommen 58734
  # -> zvE 58734 -> tarifliche 13747 -> festzusetzende 13747
  definition r equals output of Einkommensteuertarif.FestzusetzendeEstEinzel with {
    -- bruttoarbeitslohn: $60,000.00
    -- werbungskosten: $0.00
    -- sonderausgaben: $0.00
    -- veranlagungszeitraum: VZ2026 }
  definition sde equals r.summe_der_einkuenfte
  definition gde equals r.gesamtbetrag_der_einkuenfte
  definition eink equals r.einkommen
  definition zve equals r.zu_versteuerndes_einkommen
  definition tarif equals r.tarifliche_est
  definition fest equals r.festzusetzende_est
  assertion sde = $58,770.00
  assertion gde = $58,770.00
  assertion eink = $58,734.00
  assertion zve = $58,734.00
  assertion tarif = $13,747.00
  assertion fest = $13,747.00

#[test]
declaration scope TestNegativeEinkuenfte:
  internal r content Einkommensteuertarif.FestzusetzendeEstEinzel
  output eink content money
  output tarif content money
  output fest content money

scope TestNegativeEinkuenfte:
  # brutto 1000, tatsaechliche WK 5000 (> Pauschbetrag): § 9a Satz 2 greift NICHT
  # -> negative Einkuenfte -4000, Einkommen -4036, tarifliche/festzusetzende 0
  definition r equals output of Einkommensteuertarif.FestzusetzendeEstEinzel with {
    -- bruttoarbeitslohn: $1,000.00
    -- werbungskosten: $5,000.00
    -- sonderausgaben: $0.00
    -- veranlagungszeitraum: VZ2026 }
  definition eink equals r.einkommen
  definition tarif equals r.tarifliche_est
  definition fest equals r.festzusetzende_est
  assertion eink = -$4,036.00
  assertion tarif = $0.00
  assertion fest = $0.00
```
