  internal r content MitunternehmerEinkuenfte
  output g content money
scope TestNull:
  definition r equals output of MitunternehmerEinkuenfte with {
    -- gewinnanteil: $0.00
    -- verguetung_taetigkeit: $0.00
    -- verguetung_darlehen: $0.00
    -- verguetung_ueberlassung: $0.00 }
  definition g equals r.einkuenfte_mitunternehmer
  assertion g = $0.00
